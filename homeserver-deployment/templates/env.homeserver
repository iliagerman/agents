# Template homeserver env file for __SERVICE__.
# Loaded by docker-compose.homeserver.yml via `env_file`.
# Never commit real secrets. If your service needs a secret, prompt the user
# at deploy time and have the deploy script write it into the `.env` next
# to the compose file instead of putting it here.

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=__PORT__

# --- Persistence ---------------------------------------------------------
# Mounted from the `__VOLUME__` named volume inside the container.
# DATABASE_URL=sqlite:////data/__SERVICE__.sqlite3

# --- Auth / mode ---------------------------------------------------------
# Production defaults. Do NOT set any *_INSECURE_DEV or DEBUG=true here.
